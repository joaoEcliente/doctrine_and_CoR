<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Transacao_pix" table="transacao_pix">

        <id name="id" type="bigint" column="id">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="valor" type="integer" nullable="false"/>

        <!-- O ENUM do banco será tratado como string pelo Doctrine -->
        <field name="status" type="string" column="status" nullable="false"/>

        <field name="dataPix"
               column="data_Pix"
               type="datetime"
               nullable="true"
               insertable="false"
               updatable="false"/>

        <many-to-one field="contaOrigem"
                     target-entity="App\Entity\Contas">
            <join-column name="conta_origem_id"
                         referenced-column-name="id"
                         nullable="true"/>
        </many-to-one>

        <many-to-one field="contaDestino"
                     target-entity="App\Entity\Contas">
            <join-column name="conta_destino_id"
                         referenced-column-name="id"
                         nullable="true"/>
        </many-to-one>

    </entity>
</doctrine-mapping>
